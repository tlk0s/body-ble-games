# Console kiosk (no desktop) — saves RAM on Pi Zero 2 W.
#
# Setup (SSH):
#   sed "s|/home/tolko|/home/YOURUSER|g" body-ble-games-kiosk.service.example | sudo tee /etc/systemd/system/body-ble-games-kiosk.service
#   sudo systemctl daemon-reload
#   sudo ./setup-console-kiosk.sh
#   sudo reboot
#
# Debug: journalctl -u body-ble-games-kiosk -b --no-pager
#        tail -50 ~/body-ble-games/pi/kiosk-update.log

[Unit]
Description=Body BLE Games full-screen (no desktop)
After=local-fs.target bluetooth.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
User=tolko
Group=tolko
SupplementaryGroups=video render input bluetooth tty
WorkingDirectory=/home/tolko/body-ble-games/pi
Environment=HOME=/home/tolko
Environment=LANG=en_GB.UTF-8
# Pre-start BT is optional (- = ignore failure); script also runs inside start-kiosk-headless.sh
ExecStartPre=-/home/tolko/body-ble-games/pi/ensure-bluetooth.sh
ExecStart=/home/tolko/body-ble-games/pi/start-kiosk-headless.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
OpenAccess=true

[Install]
WantedBy=multi-user.target
